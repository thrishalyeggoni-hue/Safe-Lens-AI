# ==============================================================================
# SAFELENS AI — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (Default is SQLite for local zero-dependency operation)
# For PostgreSQL: postgresql://user:password@localhost:5432/safelens
DATABASE_URL=sqlite:///./safelens.db

# Security & Session Secret (Generate a strong 32+ character random string for production)
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production-use

# Google Safe Browsing API v4 Key (Optional - enables live threat intelligence for URLs)
# Obtain a free non-commercial key at: https://console.cloud.google.com/apis/credentials
# Leave empty to run with deterministic structural, DNS & redirect inspections
SAFE_BROWSING_API_KEY=
SAFE_BROWSING_NONCOMMERCIAL=true

# Local AI Server (Ollama with Qwen model)
# Install Ollama from https://ollama.com and run: ollama run qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Content Retention (Hours before raw transient files/data are purged)
RETENTION_HOURS=24
