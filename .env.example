# Enable Web Risk API in a Google Cloud project; use a restricted backend key.
# Leave empty to report reputation as unavailable (never as a non-match).
GOOGLE_WEB_RISK_API_KEY=

# Local contextual Message Check. No model is automatically installed or started.
OLLAMA_BASE_URL=http://127.0.0.1:11434
MESSAGE_OLLAMA_MODEL=qwen3:4b
MESSAGE_AI_ENABLED=true

# Local screenshot OCR; provision models explicitly once, never during uploads.
# .venv/bin/python scripts/setup_screenshot_ocr.py
SCREENSHOT_OCR_TIMEOUT=60
SCREENSHOT_MIN_CONFIDENCE=0.80
